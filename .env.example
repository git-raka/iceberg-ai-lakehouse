# Copy to .env (`make env` does this and fills every secret with a random value).
# Never commit .env.

# Bind address for the web UIs and APIs published to the host.
# 127.0.0.1 keeps everything on this machine; set 0.0.0.0 only behind a firewall/reverse proxy.
HOST_BIND=127.0.0.1

# Postgres (sources, catalog metadata, Dagster, Superset, vector store)
POSTGRES_USER=lakehouse
POSTGRES_PASSWORD=change-me

# S3-compatible object storage (SeaweedFS)
S3_ACCESS_KEY=lakehouse
S3_SECRET_KEY=change-me
S3_BUCKET=lakehouse

# Iceberg REST catalog (Lakekeeper)
LAKEKEEPER_ENCRYPTION_KEY=change-me-32-characters-minimum!!
ICEBERG_WAREHOUSE=lakehouse

# Superset
SUPERSET_SECRET_KEY=change-me
SUPERSET_ADMIN_PASSWORD=change-me

# Local LLM (Ollama). Any Ollama model with tool calling works for the agent.
LLM_MODEL=qwen2.5:7b
EMBED_MODEL=nomic-embed-text

# Data/AI API keys -> Trino identity. Governance (row filters, column masks) follows the identity,
# for dashboards, SQL, text-to-SQL and the AI agent alike. `make env` replaces these with random keys.
API_KEYS_JSON={"demo-admin-key":"admin","demo-exec-key":"executive","demo-finance-key":"analyst_finance","demo-tenant-t003-key":"tenant_t003","demo-vendor-key":"vendor_haulage"}
# The identity the MCP server runs as: one of the keys above (the executive key by default).
MCP_API_KEY=demo-exec-key

# Optional Cube layer (`make cube-up`): secret that signs the demo API tokens (`make cube-token`).
CUBE_API_SECRET=change-me
